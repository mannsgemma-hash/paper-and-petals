# Paper & Petals — environment variables
#
# Copy to `.env` for local dev (`npx expo start`). For EAS *cloud* builds a
# gitignored `.env` is NOT uploaded — set these as EAS environment variables
# instead (see BUILD.md). Every value here is EXPO_PUBLIC_*, meaning it is
# embedded in the client bundle by design — none of these are secrets.
#
# The app runs without any of these: it's crash-proof and journals persist
# on-device (local-first). Each var only enables the feature noted below.

# ── Cloud sync + mailing list (optional; app is local-first without it) ───────
# Without these the app skips cloud sync and just saves journals on-device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Analytics + crash reporting (recommended for test builds) ─────────────────
# Needed for the in-app error reporter to actually reach you. Host has a default.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Live shop content (has working defaults; override only to point elsewhere) ─
EXPO_PUBLIC_SANITY_PROJECT_ID=cv53e819
EXPO_PUBLIC_SANITY_DATASET=production

# ── In-app purchases ──────────────────────────────────────────────────────────
# iOS has a built-in public key default; Android needs its key or IAP is off.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ── Push notifications (optional) ─────────────────────────────────────────────
# Empty = notifications disabled (no crash).
EXPO_PUBLIC_ONESIGNAL_APP_ID=
